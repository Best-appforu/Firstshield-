<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🛡 FirstShield"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"/>
        </LinearLayout>

        <!-- Status bar -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_status_active"
            android:text="🛡 FirstShield is ACTIVE"/>

        <!-- Master Toggle Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Master On/Off"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pause all alerts instantly"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchMaster"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>
        </LinearLayout>

        <!-- Permission Warnings Container -->
        <LinearLayout
            android:id="@+id/containerPermWarnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"/>

        <!-- Grant Overlay Permission Button -->
        <Button
            android:id="@+id/btnRequestOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant Overlay Permission"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            android:backgroundTint="@color/accent_orange"/>

        <!-- Grant Usage Access Button -->
        <Button
            android:id="@+id/btnRequestUsageAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant Usage Access"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/accent_orange"/>

        <!-- App Scanner Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍 App Permission Scanner"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scans all installed apps locally — no internet required."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnScanApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan My Apps Now"
                android:backgroundTint="@color/primary"/>

            <TextView
                android:id="@+id/tvScanResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:layout_marginTop="12dp"
                android:lineSpacingMultiplier="1.5"/>
        </LinearLayout>

        <!-- Family Safety Tools Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠 Family Safety Tools"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quick shortcuts to protect your family online."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="14dp"/>

            <!-- Private DNS Button -->
            <Button
                android:id="@+id/btnPrivateDns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌐  Set Private DNS (Block Ads &amp; Adult Content)"
                android:textSize="13sp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#5B21B6"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Opens DNS settings → enter: family.adguard-dns.com"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="14dp"
                android:paddingStart="4dp"/>

            <!-- YouTube Restricted Mode Button -->
            <Button
                android:id="@+id/btnYouTubeRestricted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▶  Open YouTube → Turn On Restricted Mode"
                android:textSize="13sp"
                android:backgroundTint="#CC0000"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Opens YouTube → Account → Settings → Restricted Mode"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:paddingStart="4dp"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- Features Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Protections"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👁  Eye Care — 20-20-20 reminder every 20 min"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📱  Screen Time — alerts after 2 hours daily"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎧  Headphone — warns if Bluetooth earphones connected"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔒  App Scanner — alerts on risky permissions at app launch"
                android:textSize="13sp"
                android:textColor="@color/text_primary"/>
        </LinearLayout>

        <!-- Privacy Guarantee -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_privacy_badge">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔐 100% Local Privacy"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/green_dark"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No internet permission. No data uploaded. Everything runs on your device only."
                android:textSize="12sp"
                android:textColor="@color/green_dark"
                android:lineSpacingMultiplier="1.4"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
