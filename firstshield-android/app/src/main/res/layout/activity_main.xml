<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ══════════ HEADER ══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_launcher_foreground"
                android:background="@drawable/ic_launcher_background"
                android:padding="4dp"
                android:layout_marginEnd="10dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FirstShield"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Family Safety &amp; Privacy Guard"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v1.0"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"/>
        </LinearLayout>

        <!-- ══════════ STATUS BAR ══════════ -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_status_active"
            android:text="🛡 FirstShield is ACTIVE"/>

        <!-- ══════════ MASTER TOGGLE ══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_card">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Master On / Off"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pause all alerts with one tap"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"/>
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchMaster"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>
        </LinearLayout>

        <!-- Permission warning containers (hidden unless needed) -->
        <LinearLayout
            android:id="@+id/containerPermWarnings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="4dp"/>
        <Button
            android:id="@+id/btnRequestOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant Overlay Permission"
            android:visibility="gone"
            android:layout_marginBottom="6dp"
            android:backgroundTint="@color/accent_orange"/>
        <Button
            android:id="@+id/btnRequestUsageAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Grant Usage Access"
            android:visibility="gone"
            android:layout_marginBottom="14dp"
            android:backgroundTint="@color/accent_orange"/>

        <!-- ══════════ SECTION TITLE ══════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏠  Family Safety Tools"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="10dp"
            android:layout_marginTop="6dp"/>

        <!-- ════════════════════════════════════════
             CARD 1 — YouTube Restricted Mode
             ════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_red">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:src="@drawable/ic_card_youtube"
                    android:layout_marginEnd="14dp"
                    android:scaleType="fitCenter"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YouTube Safe Mode"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#CC0000"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Blocks inappropriate videos and adult content for children on YouTube."
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:lineSpacingMultiplier="1.4"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnYouTubeRestricted"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="▶  Open YouTube — Turn On Restricted Mode"
                android:textSize="12sp"
                android:backgroundTint="#CC0000"/>
        </LinearLayout>

        <!-- ════════════════════════════════════════
             CARD 2 — Private DNS
             ════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_purple">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:src="@drawable/ic_card_dns"
                    android:layout_marginEnd="14dp"
                    android:scaleType="fitCenter"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Private DNS Blocker"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#7B1FA2"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Blocks adult ads and inappropriate pop-ups inside games and apps."
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:lineSpacingMultiplier="1.4"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Enter: family.adguard-dns.com"
                        android:textSize="11sp"
                        android:textStyle="italic"
                        android:textColor="#9C27B0"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnPrivateDns"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="🌐  Open DNS Settings"
                android:textSize="12sp"
                android:backgroundTint="#7B1FA2"/>
        </LinearLayout>

        <!-- ════════════════════════════════════════
             CARD 3 — App Permissions Scanner
             ════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_teal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:src="@drawable/ic_card_permissions"
                    android:layout_marginEnd="14dp"
                    android:scaleType="fitCenter"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="App Permissions Scanner"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#00695C"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Stops hidden apps from secretly accessing your camera, location, and photos."
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:lineSpacingMultiplier="1.4"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnScanApps"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="🔍  Scan My Apps Now"
                android:textSize="12sp"
                android:backgroundTint="#00897B"/>

            <TextView
                android:id="@+id/tvScanResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.5"/>
        </LinearLayout>

        <!-- ════════════════════════════════════════
             CARD 4 — Play Protect Scan
             ════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_green">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:src="@drawable/ic_card_playprotect"
                    android:layout_marginEnd="14dp"
                    android:scaleType="fitCenter"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Play Protect Scan"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1B5E20"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Scans and cleans malware, viruses, and risky apps installed on your phone."
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:lineSpacingMultiplier="1.4"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnPlayProtect"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="🛡  Run Play Protect Scan"
                android:textSize="12sp"
                android:backgroundTint="#2E7D32"/>
        </LinearLayout>

        <!-- ════════════════════════════════════════
             CARD 5 — Cyber Helpline
             ════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_blue">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:src="@drawable/ic_card_helpline"
                    android:layout_marginEnd="14dp"
                    android:scaleType="fitCenter"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cyber Crime Helpline"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Direct helpline if you face financial fraud, fake loan apps, or online scams."
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:lineSpacingMultiplier="1.4"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="National Cyber Crime Helpline — 1930"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnHelpline"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="📞  Call 1930 — Cyber Crime Helpline"
                android:textSize="12sp"
                android:backgroundTint="#1565C0"/>
        </LinearLayout>

        <!-- ════════════════════════════════════════
             SECTION HEADER — Device & Emergency Safety
             ════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="10dp">

            <View
                android:layout_width="4dp"
                android:layout_height="22dp"
                android:background="#E53935"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Device &amp; Emergency Safety"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#B71C1C"/>
        </LinearLayout>

        <!-- ════════════════════════════════════════
             CARD 6 — Emergency SOS
             ════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_orange">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:src="@drawable/ic_card_emergency"
                    android:layout_marginEnd="14dp"
                    android:scaleType="fitCenter"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emergency SOS"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#B71C1C"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quick access to National Emergency Helpline (112) and Childline (1098)."
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:lineSpacingMultiplier="1.4"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="112 — Emergency  •  1098 — Childline"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#C62828"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnEmergencySOS"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="🚨  Call Emergency (112 / 1098)"
                android:textSize="12sp"
                android:backgroundTint="#C62828"/>
        </LinearLayout>

        <!-- ════════════════════════════════════════
             CARD 7 — Battery &amp; Device Health Safety
             ════════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_amber">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:src="@drawable/ic_card_battery"
                    android:layout_marginEnd="14dp"
                    android:scaleType="fitCenter"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Battery &amp; Device Health"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#E65100"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Monitor battery health and prevent phone overheating risks."
                        android:textSize="12sp"
                        android:textColor="#555555"
                        android:lineSpacingMultiplier="1.4"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnBatterySettings"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="🔋  Open Battery Settings"
                android:textSize="12sp"
                android:backgroundTint="#E65100"/>
        </LinearLayout>

        <!-- ══════════ PRIVACY BADGE ══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/bg_privacy_badge">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔐  100% Local Privacy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/green_dark"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No internet permission. No data uploaded. Everything runs on your device only."
                android:textSize="11sp"
                android:textColor="@color/green_dark"
                android:lineSpacingMultiplier="1.4"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
