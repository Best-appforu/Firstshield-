<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="28dp"
        android:paddingVertical="16dp">

        <!-- Emoji + Step label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Permission 1 of 3"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🪟"
            android:textSize="64sp"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Display Over Other Apps"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This lets FirstShield show eye care reminders, screen time warnings, and permission alerts as pop-ups over whatever app you're using."
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:lineSpacingMultiplier="1.5"
            android:layout_marginBottom="24dp"/>

        <!-- How to grant — step-by-step -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="How to grant it:"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp"/>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="1️⃣  Tap "Grant Permission" below"
                android:textSize="13sp" android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="2️⃣  Find "FirstShield" in the list"
                android:textSize="13sp" android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="3️⃣  Toggle \"Allow display over other apps\" ON"
                android:textSize="13sp" android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="4️⃣  Press Back to return here"
                android:textSize="13sp" android:textColor="@color/text_primary"/>
        </LinearLayout>

        <!-- Status badge -->
        <TextView
            android:id="@+id/tvOverlayStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠ Not yet granted"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#8B3A00"
            android:layout_marginBottom="14dp"/>

        <!-- Grant button -->
        <Button
            android:id="@+id/btnGrantOverlay"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Grant Permission →"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary"
            android:textColor="@android:color/white"/>

        <!-- Why safe note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔒 FirstShield never reads your screen content — it only draws its own pop-ups on top."
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:paddingTop="12dp"/>
    </LinearLayout>
</ScrollView>
