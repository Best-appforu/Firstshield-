<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FFF8F0">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎧"
        android:textSize="72sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bluetooth Headphones Detected"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#8B3A00"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="You're using wireless earphones. Did you know wired headphones are healthier for your ears?"
        android:textSize="14sp"
        android:textColor="#A0522D"
        android:gravity="center"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginBottom="24dp"/>

    <!-- Comparison card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="#FFF0DC"
        android:layout_marginBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Why wired is better 🎵"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#8B3A00"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📡  Bluetooth emits low-level radiation near your ears"
            android:textSize="13sp"
            android:textColor="#A0522D"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔋  No battery, no signal — just clean audio"
            android:textSize="13sp"
            android:textColor="#A0522D"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔊  Better sound quality at lower volume"
            android:textSize="13sp"
            android:textColor="#A0522D"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡  Tip: Keep volume below 60% for safe listening"
            android:textSize="13sp"
            android:textColor="#A0522D"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnGotIt"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Got it, thanks! 👍"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#D97706"
        android:textColor="@android:color/white"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnDismiss"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Dismiss"
        android:textSize="14sp"
        android:backgroundTint="#FFF0DC"
        android:textColor="#8B3A00"/>

</LinearLayout>
